{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compila Modulo Pybind11 Locale",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/LD", 
                "/std:c++latest",
                "/I", "${fileDirname}\\pybind11\\include",
                "/I", "C:\\Users\\Studente\\AppData\\Local\\Programs\\Python\\Python314\\include",
                "${fileDirname}\\*.cpp", 
                "/Fe:${fileDirname}\\Comunication.pyd",
                "/link",
                "/LIBPATH:C:\\Users\\Studente\\AppData\\Local\\Programs\\Python\\Python314\\libs",
                "python314.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "base": "$mscompile",
                "fileLocation": "absolute"
            },
            "group": {
                "kind": "build",
                "isDefault": true // <-- QUESTO DICE A VS CODE DI USARE QUESTO TASK CON CTRL+SHIFT+B!
            }
        }
    ]
}